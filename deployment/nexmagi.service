# systemd service file for NexMAGI
# Place this file in /etc/systemd/system/nexmagi.service

[Unit]
Description=NexMAGI FastAPI Application
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/nexmagi/backend
Environment="PATH=/opt/nexmagi/venv/bin"
Environment="OPENAI_API_KEY=replace-with-any-string"
Environment="GEMINI_API_KEY=replace-with-any-string"
ExecStart=/opt/nexmagi/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4

# 再起動設定
Restart=always
RestartSec=10

# ログ設定
StandardOutput=append:/var/log/nexmagi/app.log
StandardError=append:/var/log/nexmagi/error.log

# セキュリティ設定
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nexmagi

[Install]
WantedBy=multi-user.target
