# ローカルワーカー設定
# このファイルを .env.worker にコピーして使用

# サーバー接続先
WORKER_SERVER_URL=http://localhost:8000

# 認証（どちらか一方を使用）
# Worker API Key（長期認証。サーバーで発行: python -m local_worker create-key --name "My Worker"）
WORKER_API_KEY=

# AI API キー（ローカル実行時に使用）
OPENAI_API_KEY=
GEMINI_API_KEY=

# 実行制御
WORKER_MAX_CONCURRENT=8     # 最大同時実行数
WORKER_POLL_INTERVAL=2.0    # ポーリング間隔（秒）
WORKER_REQUEST_TIMEOUT=3600 # LLM リクエストタイムアウト（秒）

# ログ
WORKER_LOG_LEVEL=INFO
