flowchart LR
  subgraph UI[Browser UI]
    EXE_UI[workflow-execute.js<br/>ステータスバー + フロービュー]
    MODAL_UI[exec-detail-modal.js<br/>coordinator view + synthesis events]
    DASH_UI[dashboard.js<br/>profile フロー表示]
    ADMIN_UI[skills.js / accounts.js<br/>WF管理 + スキル有効化]
  end

  subgraph API[FastAPI v2.0.0]
    EXEC_API[execute.py<br/>WF実行 + synthesis_log: workflow_start]
    USER_API[user.py<br/>coordinator_view + synthesis_events<br/>step_profiles]
    WORKER_API[worker.py<br/>bundle + Memory注入 + Leader/Judge自動生成]
    ADMIN_API[admin.py<br/>WF status + assign-workflow<br/>workflow_count]
  end

  subgraph ORCH[Orchestration / Services]
    TASKS[execution_tasks.py<br/>continue_workflow_execution<br/>auto overrides + session events]
    COMPLETE[completion_service.py<br/>append_synthesis_event<br/>memory update + session step/runtime/artifact events]
    AUTO[auto_orchestration.py<br/>output_key / retry / quality_gate / judge<br/>自動推論]
    MEMORY[memory_service.py<br/>永続メモリ get/update]
    PROFILE[agent_profiles.py<br/>5 profiles + 証跡フォーマット]
    WORKER[local_worker<br/>LLM実行]
    SESSION[session_service.py<br/>create / status / bind_runtime<br/>bind_workspace / resume_cursor]
    EVENTS[session_events.py<br/>emit_session_event<br/>30 normalized event types]
    APPROVAL[approval_service.py<br/>create / resolve / idempotent<br/>session transition]
  end

  subgraph TAURI[Tauri Desktop Rust]
    CLI_RUNNER[external_cli_runner.rs<br/>spawn + capability gate<br/>+ approval gate]
    CLI_APPROVAL[external_cli_approval.rs<br/>ApprovalGate oneshot<br/>+ submit_workflow_approval_response]
    WORKSPACES[workspaces.rs<br/>ensure_dir / promote / cleanup<br/>+ workspace_list_active]
  end

  subgraph DB[MySQL]
    WF_EXEC[(workflow_executions<br/>synthesis_log + session columns<br/>session_id / session_status<br/>runtime_bindings / workspace_bindings<br/>approval_summary / artifact_refs)]
    EXEC[(executions<br/>agent_profile<br/>_nexmagi_continuation)]
    WF_SKILL[(workflow_skills)]
    SKILL[(skills)]
    WF_MEM[(workflow_memories<br/>永続メモリ + starter_seed)]
    COORD_EVT[(coordinator_events<br/>+ session_id / step_id<br/>+ event_seq / event_namespace)]
    APPROVAL_TBL[(approval_requests<br/>approval_id / status<br/>decided_by / decided_at)]
    ADAPTER_TBL[(coordinator_adapters<br/>+ risk_level / requires_workspace<br/>+ default_approval_policy)]
  end

  ADMIN_UI -->|WF/スキル管理 + 一括有効化| ADMIN_API
  ADMIN_API -->|WRITE| SKILL
  ADMIN_API -->|WRITE| WF_SKILL
  ADMIN_API -->|READ coordinator_view| USER_API

  DASH_UI -->|step_profiles フロー表示| USER_API
  EXE_UI -->|WF実行開始| EXEC_API
  EXEC_API -->|CREATE + synthesis_log: workflow_start| WF_EXEC
  EXEC_API -->|CREATE execution| EXEC

  TASKS -->|compute_orchestration_overrides| AUTO
  AUTO -->|output_key / retry / quality_gate / judge| TASKS
  TASKS -->|READ/WRITE blackboard + stage| WF_EXEC
  TASKS -->|synthesis_log: group_complete + leader_start| WF_EXEC
  TASKS -->|CREATE execution + _nexmagi_continuation| EXEC

  WORKER_API -->|READ profile + Memory| WF_MEM
  WORKER_API -->|compose prompt| PROFILE
  WORKER_API -->|bundle配信| WORKER

  WORKER -->|結果| COMPLETE
  COMPLETE -->|synthesis_log: step_complete| WF_EXEC
  COMPLETE -->|memory update| WF_MEM
  COMPLETE -->|handoff_summary + envelope| WF_EXEC
  COMPLETE -->|final_verdict| WF_EXEC
  COMPLETE -->|session events| SESSION
  COMPLETE -->|step.completed + runtime.selected + artifact.created| EVENTS

  SESSION -->|session columns| WF_EXEC
  EVENTS -->|normalized events| COORD_EVT
  APPROVAL -->|WRITE| APPROVAL_TBL
  APPROVAL -->|session transition| SESSION
  TASKS -->|step.started + session.step_entered| EVENTS

  CLI_RUNNER -->|approval_requested event| EXE_UI
  CLI_APPROVAL -->|POST respond| USER_API
  CLI_APPROVAL -->|resolve oneshot| CLI_RUNNER
  WORKSPACES -->|POST path/promote/cleanup| WORKER_API

  USER_API -->|coordinator_view + synthesis_events| EXE_UI
  USER_API -->|coordinator_view + synthesis_events| MODAL_UI
  USER_API -->|session + events + approvals| EXE_UI

