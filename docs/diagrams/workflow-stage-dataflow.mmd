  classDef svc fill:#6d28d9,stroke:#c4b5fd,color:#fff;
  classDef tauri fill:#9a3412,stroke:#fdba74,color:#fff;

  class WF_EXEC,EXEC,WF_SKILL,SKILL,WF_MEM,COORD_EVT,APPROVAL_TBL,ADAPTER_TBL db;
  class EXEC_API,USER_API,WORKER_API,ADMIN_API api;
  class EXE_UI,MODAL_UI,DASH_UI,ADMIN_UI ui;
  class TASKS,COMPLETE,AUTO,MEMORY,PROFILE,WORKER,SESSION,EVENTS,APPROVAL svc;
  class CLI_RUNNER,CLI_APPROVAL,WORKSPACES tauri;
